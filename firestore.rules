rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() {
   return request.auth != null
    && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
  }
  match /admins/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, write: if false;
  }
  match /site/content { allow read: if true; allow write: if isAdmin(); }
  match /private/content { allow read, write: if isAdmin(); }
  match /inquiries/{id} {
   allow read, update, delete: if isAdmin();
   allow create: if request.resource.data.keys().hasOnly(['name','email','type','date','location','message','createdAt','read'])
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
    && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
    && request.resource.data.type in ['Weddings','Birthdays','Graduations','Portraits','Pre-shoots','Something else']
    && request.resource.data.date is string && request.resource.data.date.size() <= 10
    && request.resource.data.location is string && request.resource.data.location.size() <= 200
    && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 3000
    && request.resource.data.createdAt == request.time && request.resource.data.read == false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
