---
import '../styles/global.css';
const { title = 'Still & Story — Photography for the moments you want to keep', admin = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content="Wedding, birthday, graduation and portrait photography. Explore the portfolio and enquire about your next chapter." />
    {admin && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#f6f4ef" />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('still-story-theme'); } catch {}
        const theme = saved === 'dark' || saved === 'light' ? saved : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#151a17' : '#f6f4ef');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
