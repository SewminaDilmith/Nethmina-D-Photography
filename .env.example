# Public browser config from Firebase > Project settings > Your apps
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key for Firebase App Check
PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Set false in production. Local demo runs only when Firebase is not configured.
PUBLIC_DEMO_MODE=true
# Vercel server-only secrets. Never add a PUBLIC_ prefix.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Name of a SIGNED image-only preset (10 MB max file size recommended)
CLOUDINARY_UPLOAD_PRESET=
